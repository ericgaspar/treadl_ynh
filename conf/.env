export FLASK_APP="app.py"
export FLASK_ENV="production"
export FLASK_RUN_PORT="__PORT__"
export FLASK_RUN_HOST="127.0.0.1"
export MAILGUN_URL=""
export MAILGUN_KEY=""
export MONGO_URL="mongodb://localhost"
export MONGO_DATABASE="treadl"
export JWT_SECRET="devsecret"
export GOOGLE_APPLICATION_CREDENTIALS="firebase.json"

export AWS_S3_ENDPOINT="http://localhost:9000"
export AWS_S3_PUBLIC_ENDPOINT=""
export AWS_S3_BUCKET="treadl"
export AWS_ACCESS_KEY_ID="minioadmin"
export AWS_SECRET_ACCESS_KEY="minioadmin"
export AWS_REQUEST_CHECKSUM_CALCULATION="when_required"
export AWS_RESPONSE_CHECKSUM_VALIDATION="when_required"
export CONTACT_EMAIL="hello@__DOMAIN__"
export FROM_EMAIL="no_reply@__DOMAIN__"
export ADMIN_EMAIL="hello@__DOMAIN__"
export APP_URL="https://__DOMAIN__"
export APP_DOMAIN="__DOMAIN__"
# Set to 1 when the API runs behind a reverse proxy that injects (and strips
# incoming) X-Forwarded-For/Proto/Host headers, so rate limits and URLs see
# the real client IP. Leave unset for direct/dev deployments.
export TRUST_PROXY_HEADERS="1"

# Comma-separated list of origins allowed to make cross-origin requests to
# the API. For local development use e.g. "http://localhost:8002".
export CORS_ORIGINS="https://treadl.com,https://www.treadl.com"
export APP_NAME="Treadl"
